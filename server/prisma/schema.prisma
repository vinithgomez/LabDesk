// LabDesk data model.
// Constraints Prisma cannot express (CHECKs, exclusion constraints) live in
// raw SQL inside the migration files. All timestamps are timestamptz (UTC).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gist, pgcrypto, citext]
}

enum UserRole {
  student
  faculty
  lab_incharge
  admin

  @@map("user_role")
}

enum BookingStatus {
  pending
  approved
  rejected
  cancelled
  checked_in
  completed
  no_show

  @@map("booking_status")
}

enum ApprovalDecision {
  approved
  rejected

  @@map("approval_decision")
}

enum CheckinMethod {
  qr
  manual_override

  @@map("checkin_method")
}

enum CheckoutMethod {
  qr
  manual_override
  auto

  @@map("checkout_method")
}

enum SeriesStatus {
  active
  cancelled

  @@map("series_status")
}

enum WaitlistStatus {
  waiting
  promoted
  expired
  cancelled

  @@map("waitlist_status")
}

enum ResourceType {
  lab
  room
  equipment

  @@map("resource_type")
}

model Department {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  code      String     @unique
  users     User[]
  resources Resource[]

  @@map("departments")
}

model User {
  id                        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                     String              @unique @db.Citext
  passwordHash              String              @map("password_hash")
  fullName                  String              @map("full_name")
  role                      UserRole            @default(student)
  departmentId              String              @map("department_id") @db.Uuid
  rollNo                    String?             @map("roll_no")
  isActive                  Boolean             @default(true) @map("is_active")
  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  department                Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  ownedResources            ResourceOwner[]
  refreshTokens             RefreshToken[]
  auditEntries              AuditLog[]
  bookings                  Booking[]
  approvalsGiven            BookingApproval[]
  checkinsOverridden        Checkin[]           @relation("CheckinOverriddenBy")
  checkoutsOverridden       Checkin[]           @relation("CheckoutOverriddenBy")
  maintenanceWindowsCreated MaintenanceWindow[]
  bookingSeries             BookingSeries[]
  waitlistEntries           WaitlistEntry[]

  @@index([departmentId])
  @@map("users")
}

model Resource {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  departmentId       String              @map("department_id") @db.Uuid
  name               String
  type               ResourceType
  location           String
  capacity           Int
  description        String              @default("")
  qrSecret           String              @default(dbgenerated("encode(gen_random_bytes(32), 'hex')")) @map("qr_secret")
  requiresApproval   Boolean             @default(false) @map("requires_approval")
  approvalLevels     Int                 @default(1) @map("approval_levels") @db.SmallInt
  minSlotMinutes     Int                 @default(30) @map("min_slot_minutes")
  maxSlotMinutes     Int                 @default(180) @map("max_slot_minutes")
  bookingHorizonDays Int                 @default(14) @map("booking_horizon_days")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  department         Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  owners             ResourceOwner[]
  bookings           Booking[]
  maintenanceWindows MaintenanceWindow[]
  bookingSeries      BookingSeries[]
  waitlistEntries    WaitlistEntry[]

  @@index([departmentId])
  @@map("resources")
}

// An owner approves bookings at exactly one level (1 or 2). For a resource
// that requires approval, every level up to approval_levels must keep at
// least one owner (enforced by ResourceService).
model ResourceOwner {
  resourceId    String   @map("resource_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  approvalLevel Int      @default(1) @map("approval_level") @db.SmallInt
  resource      Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([resourceId, userId])
  @@index([userId])
  @@map("resource_owners")
}

// Server-side record of issued refresh tokens, required for rotation and
// reuse detection. Every token belongs to a family (one login session);
// presenting an already-rotated token revokes the whole family.
model RefreshToken {
  id        String    @id @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

// Append-only record of mutations, written by writeAudit() inside the same
// transaction as the change it describes. Snapshots are redacted: no
// password hashes, QR secrets or tokens are ever stored here.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Nullable for future system actors (scheduled jobs); every Phase 1
  // mutation records the acting user.
  actorId    String?  @map("actor_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  action     String
  before     Json?    @db.JsonB
  after      Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
  @@map("audit_log")
}

// period is a half-open tstzrange [start, end). Prisma has no range type, so
// the column is Unsupported and every booking query is raw SQL in
// BookingRepository. Range CHECKs live in the migration.
model Booking {
  id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceId     String                   @map("resource_id") @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  period         Unsupported("tstzrange")
  status         BookingStatus            @default(pending)
  purpose        String                   @default("")
  attendeeCount  Int                      @default(1) @map("attendee_count")
  // Set on bookings materialized from a recurring series.
  seriesId       String?                  @map("series_id") @db.Uuid
  idempotencyKey String?                  @map("idempotency_key")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  resource       Resource                 @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  series         BookingSeries?           @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  approvals      BookingApproval[]
  checkin        Checkin?
  waitlistEntry  WaitlistEntry?

  @@index([resourceId])
  @@index([userId])
  @@index([seriesId])
  @@map("bookings")
}

// Blocks bookings for a resource during [start, end). Windows for one
// resource may not overlap each other (exclusion constraint in the
// migration). The booking service rejects bookings that overlap a window
// with MAINTENANCE_BLOCKED. Endpoints for managing windows are Phase 7.
model MaintenanceWindow {
  id         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceId String                   @map("resource_id") @db.Uuid
  period     Unsupported("tstzrange")
  reason     String                   @default("")
  createdBy  String                   @map("created_by") @db.Uuid
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  resource   Resource                 @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  creator    User                     @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([createdBy])
  @@map("maintenance_windows")
}

// One row per approval decision (CLAUDE.md §4). Written only by
// transitionBooking. A booking gets at most one decision per level and at
// most one decision per approver, so one person can never satisfy both levels.
model BookingApproval {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String           @map("booking_id") @db.Uuid
  level      Int              @db.SmallInt
  approverId String           @map("approver_id") @db.Uuid
  decision   ApprovalDecision
  comment    String           @default("")
  decidedAt  DateTime         @default(now()) @map("decided_at") @db.Timestamptz(6)
  booking    Booking          @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  approver   User             @relation(fields: [approverId], references: [id], onDelete: Restrict)

  @@unique([bookingId, level])
  @@unique([bookingId, approverId])
  @@index([approverId])
  @@map("booking_approvals")
}

// Actual usage against booked usage (CLAUDE.md §4 checkins, §7). One row per
// booking, created by check-in and completed by check-out; actual minutes are
// derived (checked_out_at - checked_in_at), never stored. Beyond §4:
// checkout_method / checkout_overridden_by record how the session ended, so
// an auto-completed session (assumed full use) is distinguishable from a real
// check-out for utilization analytics.
model Checkin {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId            String          @unique @map("booking_id") @db.Uuid
  checkedInAt          DateTime        @map("checked_in_at") @db.Timestamptz(6)
  checkedOutAt         DateTime?       @map("checked_out_at") @db.Timestamptz(6)
  checkinMethod        CheckinMethod   @map("checkin_method")
  overriddenBy         String?         @map("overridden_by") @db.Uuid
  checkoutMethod       CheckoutMethod? @map("checkout_method")
  checkoutOverriddenBy String?         @map("checkout_overridden_by") @db.Uuid
  booking              Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  overrider            User?           @relation("CheckinOverriddenBy", fields: [overriddenBy], references: [id], onDelete: Restrict)
  checkoutOverrider    User?           @relation("CheckoutOverriddenBy", fields: [checkoutOverriddenBy], references: [id], onDelete: Restrict)

  @@map("checkins")
}

// A recurring booking (CLAUDE.md §4 booking_series). rrule is the RFC 5545
// subset FREQ=WEEKLY;BYDAY=...;UNTIL=...; start_time is an IST wall-clock
// time. Occurrences are materialized as ordinary bookings (series_id set),
// through the normal insert path, up to the resource's booking horizon.
// Beyond §4: purpose / attendee_count (copied onto every occurrence), status
// and cancelled_at, and materialized_through — the start of the last
// occurrence the materializer processed (booked or skipped), so a run never
// revisits an occurrence.
model BookingSeries {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceId          String              @map("resource_id") @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  rrule               String
  startTime           DateTime            @map("start_time") @db.Time(0)
  durationMinutes     Int                 @map("duration_minutes")
  purpose             String              @default("")
  attendeeCount       Int                 @default(1) @map("attendee_count")
  status              SeriesStatus        @default(active)
  materializedThrough DateTime?           @map("materialized_through") @db.Timestamptz(6)
  cancelledAt         DateTime?           @map("cancelled_at") @db.Timestamptz(6)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  resource            Resource            @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  user                User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  bookings            Booking[]
  skips               BookingSeriesSkip[]

  @@index([resourceId])
  @@index([userId])
  @@map("booking_series")
}

// An occurrence the materializer could not book (e.g. SLOT_CONFLICT), kept so
// GET /api/series/:id can say which dates are missing and why. Skipped
// occurrences are not retried.
model BookingSeriesSkip {
  id         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seriesId   String                   @map("series_id") @db.Uuid
  occurrence Unsupported("tstzrange")
  reason     String
  message    String
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  series     BookingSeries            @relation(fields: [seriesId], references: [id], onDelete: Restrict)

  @@index([seriesId])
  @@map("booking_series_skips")
}

// A request to be booked into a held slot if it frees (CLAUDE.md §4). Beyond
// §4: purpose / attendee_count (carried onto the promoted booking, which is
// validated exactly like any other) and booking_id (the booking a promoted
// entry became). One 'waiting' entry per user per overlapping period on a
// resource (exclusion constraint in the migration).
model WaitlistEntry {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceId    String                   @map("resource_id") @db.Uuid
  userId        String                   @map("user_id") @db.Uuid
  desiredPeriod Unsupported("tstzrange") @map("desired_period")
  purpose       String                   @default("")
  attendeeCount Int                      @default(1) @map("attendee_count")
  status        WaitlistStatus           @default(waiting)
  bookingId     String?                  @unique @map("booking_id") @db.Uuid
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  resource      Resource                 @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  user          User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking       Booking?                 @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("waitlist_entries")
}
