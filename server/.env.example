NODE_ENV=development
PORT=4000

# Local Postgres (docker-compose.yml and the test container read these).
# DATABASE_URL below must use the same user, password and database.
POSTGRES_USER=labdesk
POSTGRES_PASSWORD=labdesk
POSTGRES_DB=labdesk

DATABASE_URL="postgresql://labdesk:labdesk@localhost:5433/labdesk?schema=public"
REDIS_URL="redis://localhost:6380"

# Base URL of the PWA, printed into every resource QR code.
# Changing it invalidates all printed QR codes, so fix it per deployment.
PUBLIC_APP_URL=http://localhost:5173
# Scheduled jobs: no-show sweeper, auto-complete, lapsed-pending expiry.
# Every instance may run them; a Redis lock ensures one run per tick.
JOBS_ENABLED=true
# Where calendar apps reach the API; defaults to PUBLIC_APP_URL (the PWA proxies /api).
# PUBLIC_API_URL=https://api.example.edu

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Signs calendar-feed URLs. Optional: derived from JWT_ACCESS_SECRET if unset.
# Changing it revokes every calendar URL already handed out.
ICS_TOKEN_SECRET=change-me-calendar-feeds
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

SEED_ADMIN_EMAIL=admin@college.edu
SEED_ADMIN_PASSWORD=ChangeMe123!
# Shared password for the seeded demo faculty/students
SEED_USER_PASSWORD=Password123!

CORS_ORIGIN=http://localhost:5173
TZ=UTC
LOG_LEVEL=info
