# Environment and secrets (.env.example is the only env file tracked)
.env
.env.*
!.env.example
*.pem
*.key

# Logs
*.log
npm-debug.log*

# Local databases (prisma lives under server/, hence **/)
**/prisma/*.db
**/prisma/*.db-journal

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# Throwaway visual-review screenshots (never committed)
.visual-review/
